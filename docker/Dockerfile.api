# syntax=docker/dockerfile:1
#
# See docker/Dockerfile.service for why the build stage uses
# eclipse-temurin:21-jdk instead of the brief's gradle:8-jdk21.
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
RUN ./gradlew :order-api:bootJar --no-daemon

FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=build /src/order-api/build/libs/*.jar app.jar
USER app
EXPOSE 8080 8081
# Container-aware heap sizing; a fixed -Xmx ignores the cgroup limit.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
